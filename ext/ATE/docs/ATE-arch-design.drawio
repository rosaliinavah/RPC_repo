        <mxCell id="8exCCuX_iSED-QHY19kr-196" value="&lt;b&gt;Parameters:&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;Path to FW&lt;/li&gt;&lt;li&gt;Path to App?&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Koska käytössä on Test App joka sijaitsee tod näk ATE repossa&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Alla olevat parametreina YAML tasolle?&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Resource file:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;border-color: var(--border-color);&quot;&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Device default properties&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;OD numbers for fw, app etc&lt;/li&gt;&lt;/ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Device configuration&lt;/li&gt;&lt;ul&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;CAN settings&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Test App parameter names&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;FW files (older versions)&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;IO pin numbers for tests&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Test App parameter &amp;lt;k:v&amp;gt; map to number&lt;/li&gt;&lt;li style=&quot;border-color: var(--border-color);&quot;&gt;Product (hw, fw) unique information (no app specific)&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;dashed=1;" vertex="1" parent="8exCCuX_iSED-QHY19kr-195">
          <mxGeometry x="40" y="38" width="280" height="312" as="geometry" />
        </mxCell>
        <mxCell id="8exCCuX_iSED-QHY19kr-197" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Verify Alias mapping against Veristand project XML, FAIL if mismatch&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;ATE waits Veristand project to be deployed based on the hardware variant&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Devices are already powered&lt;/li&gt;&lt;li&gt;IO cables are connected&lt;/li&gt;&lt;li&gt;IOs are in default state (0 volts)&lt;/li&gt;&lt;li&gt;Relays for DUT are off&lt;/li&gt;&lt;li&gt;CAN power on, offline&lt;/li&gt;&lt;li&gt;CAN not initialized&lt;/li&gt;&lt;li&gt;CAN terminated by default ?&lt;/li&gt;&lt;li&gt;PXI || SLSC fault injections IOs are connected&lt;/li&gt;&lt;li&gt;PXI || SLSC fault injections IOs are deactivated&lt;/li&gt;&lt;li&gt;MUXes are in default state (NC)&lt;/li&gt;&lt;li&gt;MUXes are connected as AO in default&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;dashed=1;" vertex="1" parent="8exCCuX_iSED-QHY19kr-195">
          <mxGeometry x="40" y="478" width="280" height="292" as="geometry" />
        </mxCell>
