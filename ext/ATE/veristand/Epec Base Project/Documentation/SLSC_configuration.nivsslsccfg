											<String>I32.bank0.NI.VsupSelect</String>
										</Property>
										<Property Name="user.CD.Documentation">
											<String>Voltage source selection for this bank. Changes to this property take effect after running the NI.ChannelConfigurationUpdate command.</String>
										</Property>
										<Property Name="Value Table">
											<Dictionary>
												<Elem Key="Vsup_Off">
													<Double>0</Double>
												</Elem>
												<Elem Key="Vsup_0">
													<Double>1</Double>
												</Elem>
												<Elem Key="Vsup_1">
													<Double>2</Double>
												</Elem>
											</Dictionary>
										</Property>
									</Properties>
									<Errors />
									<DefaultValue>
										<Elem>0</Elem>
									</DefaultValue>
								</Channel>
								<Channel Name="NI.RangeEnable5V" TypeGUID="c82b20b8-f784-4ce0-9686-ded74c652b63" Identifier="21c72ed0-df1d-4790-b29e-87360f458ad0" RowDim="1" ColDim="1" Units="" BitFields="3">
									<Description>Voltage range selection</Description>
									<Properties>
										<Property Name="user.CD.SLSCChannelPath">
											<String>Bool.bank0.NI.RangeEnable5V</String>
										</Property>
										<Property Name="user.CD.Documentation">
											<String>Enable for this bank's voltage range. When enabled, this bank uses the NI.InputThreshold5V for the input threshold. When disabled, this bank uses the NI.InputThreshold60V for the input threshold. Changes to this property take effect after running the NI.ChannelConfigurationUpdate command.</String>
										</Property>
									</Properties>
									<Errors />
									<DefaultValue>
										<Elem>0</Elem>
									</DefaultValue>
								</Channel>
								<Channel Name="NI.InputThreshold5V" TypeGUID="c82b20b8-f784-4ce0-9686-ded74c652b63" Identifier="e27ebb47-ff80-4dcd-b0c4-cb5e10e99c57" RowDim="1" ColDim="1" Units="" BitFields="3">
									<Description>Input threshold voltage for the 5 V range</Description>
									<Properties>
										<Property Name="user.CD.SLSCChannelPath">
											<String>Double.bank0.NI.InputThreshold5V</String>
										</Property>
										<Property Name="user.CD.Documentation">
											<String>Input threshold voltage for this bank when its NI.RangeEnable5V is true. Changes to this property take effect after running the NI.ChannelConfigurationUpdate command.</String>
										</Property>
									</Properties>
									<Errors />
									<DefaultValue>
										<Elem>0.9189</Elem>
									</DefaultValue>
								</Channel>
								<Channel Name="NI.InputThreshold60V" TypeGUID="c82b20b8-f784-4ce0-9686-ded74c652b63" Identifier="72b0417f-0b72-4a22-a629-c3c78fcddbed" RowDim="1" ColDim="1" Units="" BitFields="3">
									<Description>Input threshold voltage for the 60 V range</Description>
									<Properties>
										<Property Name="user.CD.SLSCChannelPath">
											<String>Double.bank0.NI.InputThreshold60V</String>
										</Property>
										<Property Name="user.CD.Documentation">
											<String>Input threshold voltage for this bank when its NI.RangeEnable5V is false. Changes to this property take effect after running the NI.ChannelConfigurationUpdate command.</String>
										</Property>
									</Properties>
									<Errors />
									<DefaultValue>
										<Elem>8.8592</Elem>
									</DefaultValue>
								</Channel>
							</Section>
						</Section>
						<Section Name="bank1" TypeGUID="03D3BB89-1485-13A6-56005DE6430FF8B7" Identifier="f4a9f98f-2595-4406-9079-34fdf2eacea8">
