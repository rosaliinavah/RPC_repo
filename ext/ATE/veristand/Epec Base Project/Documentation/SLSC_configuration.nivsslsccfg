						<Section Name="port0/line0" TypeGUID="03D3BB89-1485-13A6-56005DE6430FF8B7" Identifier="ff1d011c-18cc-448d-9718-6051983469af">
							<Description />
							<Properties />
							<Errors />
							<Section Name="Properties" TypeGUID="43ced8ca-9492-4202-95f8-a70989870370" Identifier="6c117dfd-17e0-4d2d-bbc1-351fe97b925f">
								<Description />
