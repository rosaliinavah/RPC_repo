								<Description />
								<Properties />
								<Errors />
								<Channel Name="NI.VsupSelect" TypeGUID="c82b20b8-f784-4ce0-9686-ded74c652b63" Identifier="3509eb89-e1e3-4377-a883-ebb641ffb5f4" RowDim="1" ColDim="1" Units="" BitFields="3">
